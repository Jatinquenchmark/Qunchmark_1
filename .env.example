# Copy to .env.local for local testing (never commit real keys).
# In production, set these in Vercel → Project → Settings → Environment Variables.

# Required — Resend API key (server-side only; never prefix with VITE_)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender on your verified Resend domain
RESEND_FROM="QuenchMark Website <enquiries@quenchmark.org>"

# Where Reach Us enquiries are delivered (comma-separate for several)
LEAD_TO_EMAIL=hiring.quenchmark@gmail.com

# Set to false to skip the acknowledgement email sent to the client
SEND_CLIENT_CONFIRMATION=true

# Optional — shared rate limiting across serverless instances (Upstash Redis)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
